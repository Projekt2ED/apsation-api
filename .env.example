# Can be either:
# 1. Base URL only: https://api.bltcy.ai
# 2. Full endpoint URL: https://api.bltcy.ai/v1/chat/completions
UPSTREAM_API_BASE_URL=https://api.bltcy.ai
UPSTREAM_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional starting balance for new/legacy users without a billing account row.
# Keep this at 0 for production; top up through billing accounts/recharge orders.
DEFAULT_ACCOUNT_BALANCE_CNY=0

# Instance-local MVP rate limit. Use Redis/Upstash later for distributed deploys.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Comma-separated admin emails for /workspace/admin.
ADMIN_EMAILS=

# Optional later, only if we adopt direct SQL/ORM locally
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=
